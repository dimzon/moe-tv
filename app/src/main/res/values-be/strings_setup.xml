    <string name="setup_refresh_title">Аўтаабнаўленне</string>
    <string name="setup_refresh_sub">Каталог каналаў і тэлегіда загружаюцца аўтаматычна. Як часта іх абнаўляць?</string>
    <string name="refresh_policy_6h">Кожныя 6 гадзін</string>
