<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- Translators: Screen title for the background-image chooser dialog. -->
    <string name="setup_background_image">Background image</string>
    <!-- Translators: Description in the background-image chooser dialog explaining what the setting does. -->
    <string name="setup_background_image_description">Pick a photo to show behind the interface, or clear it to restore solid panels.</string>
    <!-- Translators: Button in the background-image chooser that selects an image stored on this TV/device. Contrasts with the Remote button, which receives an image from another device. -->
    <string name="setup_from_device">Local</string>
    <!-- Translators: Button label used in three places: (1) Add-source chooser card for the remote companion flow, (2) Import-backup chooser card for uploading from another device, (3) Background-image chooser button for the remote companion flow. Always means "use a phone, tablet or computer on the same Wi-Fi". Contrasts with Local/Manual. -->
    <string name="setup_from_phone">Remote</string>
    <!-- Translators: Screen title for the remote-background dialog shown on the TV when sending a background image from another device. -->
    <string name="setup_send_from_phone">Send from another device</string>
    <!-- Translators: Description in the remote-background dialog explaining how to send an image from another device. -->
    <string name="setup_phone_background_description">On any device with a browser on the same Wi-Fi — a phone, a computer or another TV — scan the QR (or open the URL), enter this PIN and send a photo. It becomes the background instantly.</string>
    <!-- Translators: Loading status shown while the companion HTTP server is starting. -->
    <string name="setup_opening_server">Opening server\u2026</string>
    <!-- Translators: Instruction above the PIN display on the TV screen, telling the user to enter it in the browser on the remote device. -->
    <string name="setup_enter_pin_browser">Enter this PIN in the browser</string>
    <!-- Translators: Label above the companion URL shown on the TV, as an alternative to scanning the QR code. -->
    <string name="setup_open_url">Or open this URL</string>
    <!-- Translators: Button label to retry after the companion server fails to start. -->
    <string name="setup_try_again">Try again</string>
    <!-- Translators: Button label to restart the companion server with a fresh PIN after too many wrong attempts. -->
    <string name="setup_start_again_new_pin">Start again with a new PIN</string>
    <!-- Translators: Error text shown when the user enters an invalid port number for the companion server. -->
    <string name="setup_companion_invalid_port">Enter a valid port between 1 and 65535.</string>
    <!-- Translators: Error text when the requested companion server port is already occupied. "port" is a numeric port such as 8080. -->
    <string name="setup_companion_port_in_use">Port <xliff:g id="port">%1$d</xliff:g> is already in use. Try another port.</string>
    <!-- Translators: Error text when the companion HTTP server fails to start for any reason. -->
    <string name="setup_companion_unavailable">Could not open the local server. Try again.</string>
    <!-- Translators: Error text shown when the companion link is locked after too many incorrect PIN attempts. Also sent as an HTTP response body to the remote browser. -->
    <string name="setup_companion_locked">Too many incorrect PIN attempts \u2014 the link was closed for safety.</string>

    <!-- Translators: Storage-browser fallback title/path label when no folder is selected. -->
    <string name="setup_pick_location">Pick a location</string>
    <!-- Translators: Button label shown in the storage browser when the app does not yet have storage permission. -->
    <string name="setup_grant_storage_access">Grant full storage access</string>
    <!-- Translators: Button label in the storage browser to confirm the currently visible folder as the download destination. -->
    <string name="setup_use_folder">Use this folder</string>
    <!-- Translators: Button label in the storage browser to create a new subfolder, and also the dialog title for naming it. -->
    <string name="setup_new_folder">New folder</string>
    <!-- Translators: Text-field label inside the new-folder sub-dialog of the storage browser. -->
    <string name="setup_folder_name">Folder name</string>
    <!-- Translators: Placeholder example shown in the new-folder name text field. -->
    <string name="setup_folder_example">e.g. My TV</string>
    <!-- Translators: Label for the "go up one directory" row in the storage browser. The two dots are a standard file-system convention. -->
    <string name="setup_from_current_folder">..</string>

    <!-- Translators: Visual drag indicator shown next to the active item during reorder mode. This is a symbol, not translatable text. -->
    <string name="setup_move_indicator">\u2195</string>

    <!-- Translators: Primary action button on the first-run welcome screen. -->
    <string name="setup_get_started">Get Started</string>
    <!-- Translators: Heading on the first-run step where the user sets interface and text size before the rest of setup. -->
    <string name="setup_display_size_title">Make it comfortable to read</string>
    <!-- Translators: Heading on the first-run disclaimer screen shown before the user can proceed. -->
    <string name="setup_before_you_start">Before you start</string>
    <!-- Translators: Body text on the first-run disclaimer screen. "МОЁ ТВ", "RuTube" are brand/protocol names that must not be translated. -->
    <string name="setup_disclaimer">МОЁ ТВ is a media player only. It includes no channels, playlists, or content of its own. Its single source is the built-in, legally accessible RuTube live catalogue, and you are responsible for using it lawfully.</string>
    <!-- Translators: Button on the first-run disclaimer screen to acknowledge and proceed. -->
    <string name="setup_i_understand">I Understand</string>
    <!-- Translators: Heading on the setup-choice screen (first run only) where the user chooses between a new profile or restoring a backup. -->
    <string name="setup_set_up_owntv">Set up МОЁ ТВ</string>
    <!-- Translators: Description on the setup-choice screen. -->
    <string name="setup_setup_choice_description">Start fresh with the built-in RuTube catalogue, or copy your data from another МОЁ ТВ device.</string>
    <!-- Translators: ChoiceCard title on the setup-choice screen for a fresh setup. -->
    <string name="setup_new_profile">Fresh start</string>
    <!-- Translators: Description text beneath the "New profile" choice card on the setup-choice screen. -->
    <string name="setup_create_profile_add_sources">Set up the built-in RuTube catalogue</string>
    <!-- Translators: ChoiceCard title on the setup-choice screen for copying everything from another МОЁ ТВ device on the same Wi-Fi. -->
    <string name="setup_sync_device">From another device</string>
    <!-- Translators: Description text beneath the "From another device" choice card. "МОЁ ТВ" is the app name and must not be translated. -->
    <string name="setup_sync_device_description">Copy everything from your other МОЁ ТВ device over Wi-Fi</string>
    <!-- Translators: ChoiceCard title for importing from a backup file. -->
    <string name="setup_import">Import</string>
    <!-- Translators: Primary button on the password-prompt screen to confirm restore with the entered password. -->
    <string name="setup_restore">Restore</string>
    <!-- Translators: Error heading on the import-progress screen when restore fails. -->
    <string name="setup_restore_failed">Restore failed</string>
    <!-- Translators: Error text when the backup file is unreadable or corrupted. -->
    <string name="setup_backup_read_failed">Couldn\'t read the backup file</string>
    <!-- Translators: Button on the import-progress screen to continue watching while the catalog loads in the background. -->
    <string name="setup_run_in_background">Run in background</string>
    <!-- Translators: Status text shown above the spinner while the catalog is being imported. -->
    <string name="setup_importing_catalog">Importing catalog\u2026</string>
    <!-- Translators: Fallback progress text shown during import when no detailed progress data is available. -->
    <string name="setup_preparing_catalog">Preparing catalog</string>
    <!-- Translators: Hint text on the import-progress screen telling the user they can start watching immediately. -->
    <string name="setup_watching_during_import">You can start watching while the rest of the catalog loads.</string>
    <!-- Translators: Heading on the import-progress screen when import succeeds. -->
    <string name="setup_all_set">All set!</string>
    <!-- Translators: Button on the import-success screen to finish setup. -->
    <string name="setup_continue">Continue</string>
    <!-- Translators: Error heading on the import-progress screen when import fails. -->
    <string name="setup_import_failed">Import failed</string>
    <!-- Translators: Button on the import-failure screen to retry the import. Capitalized as a standalone button label. -->
    <string name="setup_try_again_caps">Try Again</string>

    <!-- Translators: Loading label while the companion server is starting. -->
    <string name="setup_opening">Opening\u2026</string>

    <!-- Translators: Error text when a local M3U playlist file cannot be opened. -->
    <string name="setup_playlist_file_unavailable">Couldn\'t open the playlist file. Pick it again; it may have moved.</string>
    <!-- Translators: Error text when a local playlist path uses an unsupported URI scheme. -->
    <string name="setup_playlist_path_unsupported">This local playlist path is not supported.</string>


    <!-- Companion web UI is rendered outside Compose but still resolves through Android resources. -->
    <!-- Translators: Page title in the companion browser tab for the PIN entry page. "МОЁ ТВ" is a brand name. -->
    <string name="companion_pin_page_title">МОЁ ТВ \u2014 Enter PIN</string>
    <!-- Translators: Heading on the companion PIN entry page. -->
    <string name="companion_pin_heading">Enter the PIN</string>
    <!-- Translators: Description on the companion PIN entry page. -->
    <string name="companion_pin_description">Type the 6-digit PIN shown on your TV to continue.</string>
    <!-- Translators: Placeholder dots shown in the PIN input field on the companion page. -->
    <string name="companion_pin_placeholder">\u2022\u2022\u2022\u2022\u2022\u2022</string>
    <!-- Translators: Accessibility label for the PIN input field on the companion page. -->
    <string name="companion_pin_aria">PIN</string>
    <!-- Translators: Button label on the companion PIN entry page to submit the PIN. -->
    <string name="companion_continue">Continue</string>
    <!-- Translators: Error text on the companion PIN entry page when the entered PIN does not match. -->
    <string name="companion_pin_mismatch">That PIN did not match \u2014 try again.</string>
    <!-- Translators: Page title in the companion browser tab for the add-source page. "МОЁ ТВ" is a brand name. -->
    <string name="companion_service_config_empty">Enter an API key, a Worker URL, or both.</string>
    <string name="companion_service_config_invalid_key">That API key does not look valid.</string>
    <string name="companion_service_config_invalid_url">Enter a valid HTTPS Worker URL.</string>
    <!-- Translators: Error on the remote page when the submitted account details are too long to be real. -->
    <string name="companion_service_config_invalid_credentials">Those account details are too long. Check them and try again.</string>
    <string name="companion_service_config_sent">The connection details are now waiting on your TV. Review and save them there.</string>
    <string name="companion_service_config_again">Send different connection details</string>
    <string name="companion_add_page_title">МОЁ ТВ \u2014 Add source</string>
    <!-- Translators: Heading on the companion add-source page. -->
    <string name="companion_add_heading">Add a source</string>
    <!-- Translators: Description on the companion add-source page. -->
    <string name="companion_add_description">Fill in one source and press Send. It appears on the TV \u2014 pick up the remote and press Start Import there when you are ready.</string>
    <!-- Translators: Label for the default-playlist toggle on the companion add-source page. -->
    <string name="companion_default_playlist">Default playlist</string>
    <!-- Translators: Button label on the companion add-source page to send the source to the TV. -->
    <string name="companion_send_to_tv">Send to TV</string>
    <!-- Translators: Tooltip/hint text on the companion add-source page explaining the Xtream sync scope options. -->
    <string name="companion_sync_xtream_hint">What to sync \u2014 Now imports first, Later syncs in the background, Off is never fetched.</string>
    <!-- Translators: Tooltip/hint text on the companion add-source page explaining the Stalker sync scope defaults. -->
    <string name="companion_sync_stalker_hint">What to sync \u2014 Live defaults to Now; Movies/Series default to Later (Stalker VOD is slow).</string>
    <!-- Translators: Page title in the companion browser tab after a source was sent successfully. "МОЁ ТВ" is a brand name. -->
    <string name="companion_saved_page_title">МОЁ ТВ \u2014 Sent</string>
    <!-- Translators: Heading on the companion success page after sending a source. The checkmark is a visual indicator. -->
    <string name="companion_saved_heading">Sent to your TV \u2713</string>
    <!-- Translators: Body text on the companion success page when a source was sent. "name" is the source name entered by the user. -->
    <string name="companion_saved_source_body"><xliff:g id="name">%1$s</xliff:g> is now on the TV\'s Add source screen. Check the details there and press Start Import on the remote.</string>
    <!-- Translators: Button on the companion success page to send another source. -->
    <string name="companion_saved_send_another">Send another source</string>
    <!-- Translators: Browser tab title of the companion page that edits one existing source. МОЁ ТВ is the app name. -->
    <string name="companion_edit_page_title">МОЁ ТВ \u2014 Edit source</string>
    <!-- Translators: Heading on the companion edit page. "name" is the name of the source being edited. -->
    <string name="companion_edit_heading">Edit <xliff:g id="name">%1$s</xliff:g></string>
    <!-- Translators: Description on the companion edit page. Send to TV is the button on this page; Save is the button on the TV's edit screen. -->
    <string name="companion_edit_description">Change what you need and press Send to TV. A field left empty keeps its current value. The changes appear on the TV \u2014 press Save there with the remote.</string>
    <!-- Translators: Placeholder inside an empty field on the companion edit page (password, MAC address, playlist address): typing nothing keeps the value the TV already has. -->
    <string name="companion_keep_current">Leave empty to keep the current one</string>
    <!-- Translators: Body text on the companion success page after an edit was sent. "name" is the source name. Save is the button on the TV's edit screen. -->
    <string name="companion_saved_edit_body">The changes to <xliff:g id="name">%1$s</xliff:g> are now on the TV\'s edit screen. Check them there and press Save on the remote.</string>
    <!-- Translators: Link on the companion success page that opens the edit page again. -->
    <string name="companion_saved_edit_again">Change something else</string>
    <!-- Translators: Body text on the companion success page when a backup was sent. -->
    <string name="companion_saved_backup_body">Your backup is now on the TV. Pick up the remote and choose which parts to restore.</string>
    <!-- Translators: Link text on the companion success page to send a different backup file. -->
    <string name="companion_saved_backup_link">Send a different file</string>
    <!-- Translators: Body text on the companion success page when a background image was sent. -->
    <string name="companion_saved_image_body">Your image is now the TV background.</string>
    <!-- Translators: Link text on the companion success page to send a different image. -->
    <string name="companion_saved_image_link">Send a different image</string>
    <!-- Translators: Page title in the companion browser tab for the backup restore page. "МОЁ ТВ" is a brand name. -->
    <string name="companion_backup_page_title">МОЁ ТВ \u2014 Restore backup</string>
    <!-- Translators: Heading on the companion backup restore page. -->
    <string name="companion_backup_heading">Restore a backup</string>
    <!-- Translators: Description on the companion backup restore page. -->
    <string name="companion_backup_description">Choose an МОЁ ТВ backup file (.own, or an older .json) and press Send. It is transferred to the TV \u2014 pick up the remote and choose what to restore there.</string>
    <!-- Translators: Label for the backup file input on the companion backup restore page. -->
    <string name="companion_backup_file">Backup file</string>
    <!-- Translators: Error text on the companion backup restore page when no file has been selected. -->
    <string name="companion_choose_backup">Please choose a backup file first.</string>
    <!-- Translators: Label for the optional playlist-file input on the companion Add a source page (M3U tab). Lets the user upload a playlist from the computer instead of typing a URL. -->
    <string name="companion_playlist_file">Or upload a playlist file</string>
    <!-- Translators: Error text on the companion Add a source page (M3U tab) when neither a playlist URL was typed nor a file chosen. -->
    <string name="companion_playlist_url_or_file">Enter a playlist URL or choose a file.</string>
    <!-- Translators: Loading status shown on the companion page while a file is being uploaded to the TV. -->
    <string name="companion_sending">Sending\u2026</string>
    <!-- Translators: Error shown in the companion browser page when an upload to the TV fails. "status" is a numeric HTTP response such as 403. -->
    <string name="companion_upload_failed">Upload failed (HTTP <xliff:g id="status">%1$d</xliff:g>). Check the PIN and try again.</string>
    <!-- Translators: Error text on the companion page when the TV cannot be reached over the network. -->
    <string name="companion_could_not_reach">Could not reach the TV. Stay on the same Wi-Fi and try again.</string>
    <!-- Translators: Error text on the companion page when the selected file cannot be read. -->
    <string name="companion_could_not_read">Could not read that file.</string>
    <!-- Translators: Page title in the companion browser tab for the background image upload page. "МОЁ ТВ" is a brand name. -->
    <string name="companion_image_page_title">МОЁ ТВ \u2014 Background image</string>
    <!-- Translators: Heading on the companion background image upload page. -->
    <string name="companion_image_heading">Send a background image</string>
    <!-- Translators: Description on the companion background image upload page. -->
    <string name="companion_image_description">Choose a photo (JPG, PNG or WebP) and press Send. It becomes the background picture behind the TV interface.</string>
    <!-- Translators: Label for the image file input on the companion image upload page. -->
    <string name="companion_image_file">Image file</string>
    <!-- Translators: Error text on the companion image upload page when no image has been selected. -->
    <string name="companion_choose_image">Please choose an image first.</string>
    <!-- Translators: Error text on the companion image upload page when the selected image exceeds 25 MB. -->
    <string name="companion_image_too_large">That image is too large (max 25 MB).</string>
    <!-- Translators: Page title in the companion browser tab for the backup download page. "МОЁ ТВ" is a brand name. -->
    <string name="companion_download_page_title">МОЁ ТВ \u2014 Download backup</string>
    <!-- Translators: Heading on the companion backup download page. -->
    <string name="companion_download_heading">Download your backup</string>
    <!-- Translators: Description on the companion backup download page. -->
    <string name="companion_download_description">Your TV has prepared an МОЁ ТВ backup file. Tap the button to save it to this device (owntv-backup.own). Keep it somewhere safe \u2014 you can restore from it later.</string>
    <!-- Translators: Button label on the companion backup download page. -->
    <string name="companion_download_backup">Download backup</string>
    <!-- Translators: Generic HTTP 400 error text on the companion web page. -->
    <string name="companion_error_bad_request">Bad request</string>
    <!-- Translators: HTTP 413 error text on the companion web page when the request body is too large. -->
    <string name="companion_error_body_too_large">Request body is too large.</string>
    <!-- Translators: HTTP 401 error text on the companion web page when the PIN is wrong. -->
    <string name="companion_error_unauthorized">Unauthorized. Check the PIN and try again.</string>
    <!-- Translators: HTTP 404 error text on the companion web page. -->
    <string name="companion_error_not_found">Not found.</string>
    <!-- Translators: Error returned to the other device when pairing for local sync could not be completed. -->
    <string name="companion_error_pair_failed">Could not pair with this device.</string>
    <!-- Translators: Title of the page shown if someone opens the local sync address in a web browser. -->
    <string name="local_sync_browser_title">МОЁ ТВ local sync</string>
    <!-- Translators: Body of the page shown if someone opens the local sync address in a web browser. Local sync talks to the МОЁ ТВ app on the other device, not to a browser. -->
    <string name="local_sync_browser_body">This address is for the МОЁ ТВ app on your other device. Open Local sync there and pick this device from the list.</string>
    <!-- Translators: Error text on the companion download page when no backup is available on the TV. -->
    <string name="companion_error_no_backup">No backup is available.</string>
    <!-- Translators: Error text on the companion download page when the backup file is too large to transfer. -->
    <string name="companion_error_backup_too_large">The backup is too large.</string>
    <!-- Translators: Error text on the companion download page when the backup file is empty. -->
    <string name="companion_error_empty_backup">The backup is empty.</string>
    <!-- Translators: Error text on the companion image upload page when the uploaded image is too large. -->
    <string name="companion_error_image_too_large">The image is too large.</string>
    <!-- Translators: Error text on the companion image upload page when the uploaded file is not a valid image. -->
    <string name="companion_error_invalid_image">That is not a valid image upload.</string>
    <!-- Translators: Error text on the companion page when required form fields are missing. -->
    <string name="companion_error_missing_fields">Required fields are missing.</string>



    <!-- Translators: Setup step name in the step dots: the display size step. -->
    <string name="setup_step_display">Display</string>
    <!-- Translators: Setup step name in the step dots: adding a playlist. -->
    <string name="setup_step_playlist">Playlist</string>
    <!-- Translators: Setup step name in the step dots: the last step, setup is finished. -->
    <string name="setup_step_ready">Ready</string>
    <!-- Translators: Key hint after Back in the setup wizard. -->
    <string name="setup_key_previous_step">Previous step</string>
    <!-- Translators: Title of the first setup step. -->
    <string name="setup_welcome_title">Welcome to МОЁ ТВ</string>
    <!-- Translators: Text under Welcome to МОЁ ТВ. -->
    <string name="setup_welcome_sub">Your own IPTV player. Choose a language to begin — you can change it later in Settings.</string>
    <!-- Translators: Text under the display size step's title. -->
    <string name="setup_display_sub">How big the interface and its text are on this TV. The row below changes as you go.</string>
    <!-- Translators: Line under UI zoom in setup. -->
    <string name="setup_line_zoom">Everything on screen</string>
    <!-- Translators: Line under Font size in setup. -->
    <string name="setup_line_font">Text only</string>
    <!-- Translators: Line under App icon in setup. -->
    <string name="setup_line_app_icon">How МОЁ ТВ appears on the TV’s home screen</string>
    <!-- Translators: Line under Searching the network in setup. -->
    <string name="setup_device_appear">Devices with Sync mode on appear here</string>
    <!-- Translators: Placeholder of the Address field when copying from another device. -->
    <string name="setup_device_address_hint">or type the other device’s address</string>
    <!-- Translators: Button that creates the profile and continues setup. -->
    <string name="setup_create_profile">Create profile</string>
    <!-- Translators: Title while a playlist imports. %1$s is the playlist's name. -->
    <string name="setup_importing_title">Importing <xliff:g id="name">%1$s</xliff:g></string>
</resources>
