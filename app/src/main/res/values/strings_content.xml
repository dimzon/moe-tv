<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">

    <!-- Translators: Dialog title for the exit-confirmation dialog. -->
    <string name="content_exit_owntv">Exit МОЁ ТВ?</string>
    <!-- Translators: Body text in the exit-confirmation dialog. -->
    <string name="content_exit_confirmation">Are you sure you want to close the app?</string>
    <!-- Translators: Dialog title shown when a previous restore was interrupted. -->
    <string name="content_restore_incomplete_title">A restore didn\'t finish</string>
    <!-- Translators: Body text explaining that a restore was interrupted. "description" is a localized summary of what was being restored. Directs the user to Settings. -->
    <string name="content_restore_incomplete_message">The app closed while restoring <xliff:g id="description">%1$s</xliff:g>, so some of it may be missing. Nothing was deleted \u2014 run the same restore again from Settings \u2192 Backup &amp; Restore to fill in the rest.</string>
    <!-- Translators: Screen title for the category browser on the Live TV screen. -->
    <string name="content_category_browser_title">Categories</string>
    <!-- Translators: Overlay title for the channel list overlay on the Live TV screen. -->
    <string name="content_channel_overlay_title">Channels</string>
    <!-- Translators: Slot label inside LiveEpgCard for the programme on air now. Says "Live" because a second card sits beside it during catch-up showing an archived programme; the two must not be confusable. -->
    <string name="content_live_now">Live now</string>
    <!-- Translators: Slot label inside LiveEpgCard for the next programme on air. See content_live_now. -->
    <string name="content_live_next">Live next</string>
    <!-- Translators: Slot label for the archived programme currently being replayed (catch-up), beside the live card. -->
    <string name="content_archive_playing">Playing</string>
    <!-- Translators: Slot label for the programme that aired immediately after the one being replayed. Reads as "and then this was on". -->
    <string name="content_archive_then">Then</string>
    <!-- Translators: Label above the player clock showing the real time and date now. Keep it short: it sits above a large clock. -->
    <string name="content_clock_current">Current time</string>
    <!-- Translators: Context-menu option to add a movie/series/channel to Favorites. -->
    <string name="content_add_favourite">Add to Favorites</string>
    <!-- Translators: Context-menu option to remove a movie/series/channel from Favorites. -->
    <string name="content_remove_favourite">Remove from Favorites</string>
    <!-- Translators: Context-menu option to reorder an item in a custom list. -->
    <string name="content_move">Move</string>
    <!-- Translators: Long-press menu entry on a category: undo the user's hides, moves and custom order inside it. -->
    <string name="content_category_restore_playlist">Restore to default</string>
    <!-- Translators: Same entry on a user-created category, which has no playlist default. -->
    <string name="content_category_restore_custom">Restore to default</string>
    <!-- Translators: Question above the list of what restoring a category to its default will change. -->
    <string name="content_category_restore_question">This will:</string>
    <!-- Translators: Confirmation line. "count" is how many hidden items in the category will be shown again. -->
    <plurals name="content_category_restore_hidden">
        <item quantity="one"><xliff:g id="count">%1$d</xliff:g> hidden item shows again</item>
        <item quantity="other"><xliff:g id="count">%1$d</xliff:g> hidden items show again</item>
    </plurals>
    <!-- Translators: Confirmation line. "count" is how many items moved out of this category return to it. -->
    <plurals name="content_category_restore_moved">
        <item quantity="one"><xliff:g id="count">%1$d</xliff:g> moved-out item returns</item>
        <item quantity="other"><xliff:g id="count">%1$d</xliff:g> moved-out items return</item>
    </plurals>
    <!-- Translators: Confirmation line: the user's manual order inside the category will be cleared. -->
    <string name="content_category_restore_order">Custom order cleared</string>
    <!-- Translators: Confirmation text when the category has no changes to undo (the only button is Cancel). -->
    <string name="content_category_restore_nothing">Category is already at the playlist default</string>
    <!-- Translators: Long-press menu entry on a category: put it behind the profile's category lock PIN. -->
    <string name="content_category_lock">Lock with PIN</string>
    <!-- Translators: Shown instead of a locked category's channels, movies or series until the PIN is entered. -->
    <string name="content_category_locked_placeholder">This category is locked</string>
    <!-- Translators: PIN prompt title after too many wrong PINs. "count" is how many seconds are left before the next try. -->
    <plurals name="content_category_pin_wait">
        <item quantity="one">Too many wrong PINs. Try again in <xliff:g id="count">%1$d</xliff:g> second</item>
        <item quantity="other">Too many wrong PINs. Try again in <xliff:g id="count">%1$d</xliff:g> seconds</item>
    </plurals>
    <!-- Translators: Context-menu option that opens the picker for moving an item into a combined category. -->
    <string name="content_move_to_category">Move to category…</string>
    <!-- Translators: Context-menu option on a channel inside a category the user created: take it out of that category only. The channel itself and its own provider category are unaffected. -->
    <string name="content_remove_from_category">Remove from this category</string>
    <!-- Translators: Button or context-menu option to play content. -->
    <string name="content_play">Play</string>
    <!-- Translators: Button to close a dialog or overlay. -->
    <string name="content_close">Close</string>
    <!-- Translators: Hint text in the rename dialog explaining the rename is local to this profile only. -->
    <string name="content_rename_hint">Only for this profile. Leave blank to restore the original name.</string>
    <!-- Translators: Current sort-mode label in the SortChip toggle. -->
    <string name="content_provider">Original order</string>
    <string name="content_provider_name">Provider: <xliff:g id="provider">%1$s</xliff:g></string>
    <!-- Translators: Context-menu option to play content in an external player. Shorter variant. -->
    <string name="content_play_external_short">Play in external player</string>
    <!-- Translators: Context-menu option to rename a Live TV channel. -->
    <string name="content_rename">Rename</string>
    <!-- Translators: Context-menu option to rename a channel specifically. -->
    <string name="content_rename_channel">Rename channel</string>
    <!-- Translators: Context-menu option to reorder a channel in a custom list. -->
    <string name="content_reorder_channel">Reorder channel</string>
    <!-- Translators: Context-menu option to hide a channel from the list. -->
    <string name="content_hide_channel">Hide channel</string>
    <!-- Translators: Context-menu option to remove content from watch history. -->
    <string name="content_remove_history">Remove from History</string>
    <!-- Translators: Empty-state message when a channel category has no channels. -->
    <string name="content_no_channels_here">No channels here.</string>
    <!-- Translators: Empty-state message when a channel search returns no results. "query" is the user\'s search text. -->
    <string name="content_no_channels_found">No channels found for \u201c<xliff:g id="query">%1$s</xliff:g>\u201d</string>
    <!-- Translators: Time range display on the EPG timeline. "start" and "stop" are times. The en-dash is a range indicator. -->
    <string name="content_live_time_range_plain"><xliff:g id="start">%1$s</xliff:g> \u2013 <xliff:g id="stop">%2$s</xliff:g></string>
    <!-- Translators: Predefined category name for the Favorites list. -->
    <string name="content_category_favorites">Favorites</string>
    <!-- Translators: Predefined category name for the History list. -->
    <string name="content_category_history">History</string>
    <!-- Translators: Predefined category name for the "All Channels" view. -->
    <string name="content_category_all_channels">All channels</string>
    <!-- Translators: Banner shown when the device is offline. -->
    <string name="content_offline_banner">You\'re offline \u2014 playback and updates won\'t work until you reconnect.</string>
    <!-- Translators: Search hint text in the category browser. -->
    <string name="content_search_categories">Search categories\u2026</string>
    <!-- Translators: Imperative action in the clickable top-bar Continue chip. -->
    <string name="content_action_resume">Resume</string>
    <!-- Translators: Action label for the "Last channel" item in the continue-watching row. -->
    <string name="content_action_last_channel">Last channel</string>
    <!-- Translators: Time range display in the EPG programme info. "start" and "end" are times. The en-dash is a range indicator. -->
    <string name="content_live_time_range"><xliff:g id="start">%1$s</xliff:g> \u2013 <xliff:g id="end">%2$s</xliff:g></string>
    <!-- Translators: Remaining time display for a live programme. "end" is the programme's time slot, e.g. "20:10 – 21:42"; "minutes" is the minutes remaining. -->
    <string name="content_live_time_remaining"><xliff:g id="end">%1$s</xliff:g> \u00b7 <xliff:g id="minutes">%2$d</xliff:g> min left</string>


    <!-- Translators: Storage location label for internal device storage. -->
    <string name="content_storage_internal">Internal storage</string>
    <!-- Translators: Storage location label for removable storage (SD card etc.). -->
    <string name="content_storage_removable">Removable storage</string>
    <!-- Translators: Storage location label for app-private storage. -->
    <string name="content_storage_app">App storage (no permission needed)</string>

    <!-- Translators: Empty-state message when the EPG channel search returns no results. "query" is the search text. -->
    <string name="content_epg_no_channels_query">No guide channels found for \u201c<xliff:g id="query">%1$s</xliff:g>\u201d.</string>
    <!-- Translators: Warning message when EPG data exists but channel IDs don\'t match. -->
    <string name="content_epg_mismatched_ids">The stored TV guide does not match the catalogue\'s channels — refresh the TV guide.</string>
    <!-- Translators: Screen title for the TV Guide / EPG screen. -->
    <string name="content_epg_title">TV Guide</string>
    <!-- Translators: Status message when no guide data is available for a channel. -->
    <string name="content_epg_no_guide">No guide.</string>
    <!-- Translators: Status message when no programme is scheduled at the current time. -->
    <string name="content_epg_no_programme">No program at this time.</string>
    <!-- Translators: Label for the guide category filter in the EPG screen. -->
    <string name="content_epg_guide_category">Guide category</string>
    <!-- Translators: Search hint text in the EPG channel browser. -->
    <string name="content_epg_search_hint">Search guide channels\u2026</string>
    <!-- Translators: Context-menu option to add a channel to favorites from the EPG screen. -->
    <string name="content_epg_add_favourite">Add to favorites</string>
    <!-- Translators: Context-menu option to remove a channel from favorites from the EPG screen. -->
    <string name="content_epg_remove_favourite">Remove from favorites</string>
    <!-- Translators: Sort option for alphabetical order in the EPG channel list. -->
    <string name="content_epg_sort_alpha">A\u2013Z</string>
    <!-- Translators: Sort option to sort EPG channels by provider. -->
    <string name="content_epg_sort_provider">Original order</string>
    <!-- Translators: Visible middle-dot separator between EPG metadata segments. -->
    <string name="content_epg_bits_separator">" · "</string>
    <!-- Translators: Context-menu option in the EPG to tune to a live channel. -->
    <string name="content_epg_watch_channel">Watch channel</string>
    <!-- Translators: Opens the per-channel adjustment that shifts guide programme times. -->
    <string name="content_epg_time_offset">EPG time offset</string>
    <!-- Translators: Compact signed EPG offset labels. "sign" is + or −; values are localized numbers. -->
    <string name="content_epg_shift_minutes"><xliff:g id="sign">%1$s</xliff:g><xliff:g id="minutes">%2$s</xliff:g>m</string>
    <string name="content_epg_shift_hours"><xliff:g id="sign">%1$s</xliff:g><xliff:g id="hours">%2$s</xliff:g>h</string>
    <string name="content_epg_shift_hours_minutes"><xliff:g id="sign">%1$s</xliff:g><xliff:g id="hours">%2$s</xliff:g>h <xliff:g id="minutes">%3$s</xliff:g>m</string>
    <string name="content_epg_offset_channel_description">Move the guide for “<xliff:g id="channel">%1$s</xliff:g>”. Use this when an East/West feed shares its guide with the other version — a negative offset pulls the guide earlier.</string>
    <string name="content_epg_offset_following_global">Following the global offset (<xliff:g id="offset">%1$s</xliff:g>)</string>
    <string name="content_epg_offset_channel_only">This channel only · global is <xliff:g id="offset">%1$s</xliff:g></string>
    <string name="content_epg_offset_use_global">Use global</string>
    <string name="content_preview_single_stream">Preview off — your provider allows one stream at a time</string>
    <!-- Translators: Placeholder of a search field that searches inside one category. "name" is the category name, e.g. Search Sky Cinema. -->
    <string name="content_search_in">Search <xliff:g id="name">%1$s</xliff:g></string>
    <!-- Translators: Live TV button that shows the channels as a TV guide grid. -->
    <string name="content_live_guide_view">Guide view</string>
    <!-- Translators: Remote-key hint: pressing OK watches the channel. Short verb. -->
    <string name="content_key_watch">Watch</string>
    <!-- Translators: Remote-key hint: pressing Menu opens the options menu. Short noun. -->
    <string name="content_key_options">Options</string>
    <!-- Translators: Heading above the provider's channel groups in the Live TV category list. Shown in capitals by the style. -->
    <string name="content_live_groups">Groups</string>
    <!-- Translators: Group label in a channel's options menu, above the ways to watch it. Shown in capitals by the style. -->
    <string name="content_menu_group_watch">Watch</string>
    <!-- Translators: Group label in a channel's options menu, above actions on the channel itself. Shown in capitals by the style. -->
    <string name="content_menu_group_channel">Channel</string>
    <!-- Translators: Group label in a channel's options menu, above the TV-guide matching actions. Shown in capitals by the style. -->
    <string name="content_menu_group_guide_data">Guide data</string>
    <!-- Translators: Group label in an options menu, above Move and Move to category. Shown in capitals by the style. -->
    <string name="content_menu_group_organise">Organize</string>
    <!-- Translators: Value beside EPG time offset in a channel's menu: the channel follows the app-wide offset. One short word. -->
    <string name="content_epg_offset_global_short">Global</string>
    <!-- Translators: Heading above the provider's channel groups, with the country code the groups share, e.g. GROUPS · DE. Shown in capitals by the style. -->
    <string name="content_live_groups_country">Groups · <xliff:g id="country">%1$s</xliff:g></string>
    <!-- Translators: Channel count beside the category name in the Live TV header, e.g. 9 channels. -->
    <plurals name="content_live_channel_count">
        <item quantity="one"><xliff:g id="count">%1$d</xliff:g> channel</item>
        <item quantity="other"><xliff:g id="count">%1$d</xliff:g> channels</item>
    </plurals>
    <!-- Translators: Live TV category holding the channels the user watched last. -->
    <string name="content_category_recently_watched">Recently watched</string>
    <!-- Translators: Programme menu action: get a prompt when this programme starts. -->
    <string name="content_remind_me">Remind me</string>
    <!-- Translators: Value beside Remind me: how long before the start the prompt comes. "duration" is e.g. 5 min. -->
    <string name="content_remind_before"><xliff:g id="duration">%1$s</xliff:g> before</string>
    <!-- Translators: Remote-key cap in a key hint: hold the OK button. Keep it very short. -->
    <string name="content_key_hold_ok">Hold OK</string>
    <!-- Translators: TV Guide: how soon the focused programme starts. "duration" is e.g. 58 min or 1 h 12 min. -->
    <string name="content_epg_starts_in">Starts in <xliff:g id="duration">%1$s</xliff:g></string>
    <!-- Translators: TV Guide day picker: the current day. -->
    <string name="content_epg_today">Today</string>
    <!-- Translators: TV Guide day picker: the day after today. -->
    <string name="content_epg_tomorrow">Tomorrow</string>
    <!-- Translators: TV Guide day picker: the day before today (catch-up days). -->
    <string name="content_epg_yesterday">Yesterday</string>
    <!-- Translators: TV Guide button that scrolls the grid back to the current time. One short word. -->
    <string name="content_epg_now_short">Now</string>
    <!-- Translators: TV Guide channel order: favourite channels at the top. -->
    <string name="content_epg_sort_favorites_first">Favorites first</string>
    <!-- Translators: Title of the TV Guide menu that picks the channel order. -->
    <string name="content_epg_order_title">Order channels by</string>
    <!-- Translators: Line under the channel-order menu title: the choice is remembered. -->
    <string name="content_epg_order_hint">Opens this way next time</string>
    <!-- Translators: Line beside the TV Guide category list title: it is the same list Live TV shows. -->
    <string name="content_epg_category_hint">Same list as Live TV</string>
    <!-- Translators: Group label in the programme menu above features that are new, e.g. Remind me. Shown in capitals by the style. -->
    <string name="content_menu_group_new">New</string>
    <!-- Translators: Button label once a reminder is set for the programme; pressing it again removes the reminder. -->
    <string name="content_reminder_set">Reminder set</string>
    <!-- Translators: Live TV button that switches from the guide grid back to the channel list. -->
    <string name="content_live_list_view">List view</string>
    <!-- Translators: Remote-key hint in the TV Guide: OK steps into a channel row to go through its programmes. Short verb. -->
    <string name="content_key_browse">Browse</string>
    <!-- Translators: Remote-key hint in the TV Guide: the key moves between channels. Short noun. -->
    <string name="content_key_channels">Channels</string>
    <!-- Translators: Remote-key hint in the TV Guide: the key moves between programmes in a row. Short noun. -->
    <string name="content_key_programmes">Programs</string>
    <!-- Translators: Remote-key hint: the key opens the app menu (the navigation rail). Short noun. -->
    <string name="content_key_menu">Menu</string>
    <!-- Translators: Remote-key hint: OK or Right goes into the page on the right. Short verb. -->
    <string name="content_key_enter">Enter</string>
    <!-- Translators: Remote-key hint: pressing OK selects the focused item. Short verb. -->
    <string name="content_key_select">Select</string>
    <!-- Translators: Remote-key hint: pressing OK again switches off the focused filter button that is on. Short verb, the opposite of "Select". -->
    <string name="content_key_unselect">Unselect</string>
    <!-- Translators: Remote-key hint: CH+/CH− jump a page up or down the list. Short noun. -->
    <string name="content_key_page">Page</string>
    <!-- Translators: Line under "Recently watched" in the history list shown over the playing video. -->
    <string name="content_history_overlay_hint">The channels you watched last, newest first</string>
    <!-- Translators: Group label in a menu above what the list shows, e.g. the TV Guide order menu. Shown in capitals by the style. -->
    <string name="content_menu_group_show">Show</string>
    <!-- Translators: TV Guide order menu: also list the channels that have no guide data (On / Off), so they can be matched. -->
    <string name="content_epg_show_empty">Channels without guide</string>
    <!-- Translators: TV Guide order menu: play the focused channel in the small video pane at the top of the Guide (On / Off). When off, the channel logo shows instead. -->
    <string name="content_epg_show_preview">Video preview</string>
    <!-- Translators: Group label in a movie / series options menu above the details actions. Shown in capitals by the style. -->
    <string name="content_menu_group_details">Details</string>
    <!-- Translators: Menu item and popup: shows everything the guide knows about one TV programme (full title, times, categories, description). -->
    <string name="content_programme_details">Program details</string>
    <!-- Translators: Group heading on the Program details page: today's programmes that have already been on. -->
    <string name="content_programmes_earlier">Earlier</string>
    <!-- Translators: Group heading on the Program details page: programmes still to come today, after the one on now. -->
    <string name="content_programmes_later">Later</string>
</resources>
