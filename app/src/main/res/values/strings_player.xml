    <!-- Translators: Error text in the direct-tune channel number card when the entered number matches no known channel. -->
    <string name="player_channel_not_found">Channel not found</string>
    <!-- Translators: Error text in the direct-tune channel number card when the entered number matches multiple channels. -->
    <string name="player_multiple_channels">Multiple channels</string>
    <!-- Translators: Error text in the direct-tune channel number card when tuning fails for an unspecified reason. -->
    <string name="player_tune_failed">Tune failed</string>
    <!-- Translators: Heading of the error overlay shown centered on the player screen when playback fails. -->
    <string name="player_playback_error">Playback error</string>
    <!-- Translators: Technical detail text below the structured error in the player error overlay. "error" is the raw engine error string, shown for debugging/bug reports. -->
    <string name="player_raw_error">err: <xliff:g id="error">%1$s</xliff:g></string>
    <!-- Translators: Shown under the loading spinner while the app waits out a provider-requested delay, then retries the channel by itself. "code" is the HTTP status (429), "reason" is the provider\'s own message and is not translated, "seconds" counts down to the automatic retry. -->
    <string name="player_provider_retry_after">HTTP <xliff:g id="code">%1$d</xliff:g>: <xliff:g id="reason">%2$s</xliff:g> Retrying in <xliff:g id="seconds">%3$d</xliff:g>s.</string>
    <!-- Translators: Substituted as the reason in player_provider_retry_after when the provider gave no message of its own. -->
    <string name="player_provider_busy">The provider is busy.</string>
    <!-- Translators: Shown under the loading spinner when a live channel that was playing has been frozen for a while and the player is reconnecting by itself (no action needed). -->
    <string name="player_reconnecting">Stream interrupted. Reconnecting…</string>
    <!-- Translators: Dialog title for the audio track selection dialog in the player HUD. -->
    <string name="player_audio_track">Audio Track</string>
    <!-- Translators: Dialog title for the subtitle track selection dialog in the player HUD. -->
    <string name="player_subtitles">Subtitles</string>
    <!-- Translators: Placeholder text in the audio or subtitle track dialog when no tracks are available. -->
    <string name="player_no_tracks">No tracks available.</string>
    <!-- Translators: Track label for image-based subtitle tracks (PGS/VOBSUB/DVB). "label" is the track name or language. -->
    <string name="player_image_track"><xliff:g id="label">%1$s</xliff:g> \u00b7 image</string>
    <!-- Translators: Section header in the audio dialog for the A/V sync adjustment controls. -->
    <string name="player_av_sync">A/V sync</string>
    <!-- Translators: Player audio menu action that stores the current A/V-sync offset for this item. -->
    <string name="player_av_sync_remember">Remember this delay</string>
    <!-- Translators: Formatted audio delay display in the A/V sync controls when delay is exactly 0ms. -->
    <string name="player_delay_zero">0 ms</string>
    <!-- Translators: Formatted audio delay display when delay is positive. The plus sign is intentional. "ms" means milliseconds. -->
    <string name="player_delay_positive">+<xliff:g id="ms">%1$d</xliff:g> ms</string>
    <!-- Translators: Formatted audio delay display when delay is negative. "ms" means milliseconds. -->
    <string name="player_delay_negative"><xliff:g id="ms">%1$d</xliff:g> ms</string>
    <!-- Translators: Dialog title for the volume adjustment dialog in the player HUD. -->
    <string name="player_volume">Volume</string>
    <!-- Translators: Button in the volume dialog to unmute audio. Shown when volume is currently 0. -->
    <string name="player_unmute">Unmute</string>
    <!-- Translators: Button in the volume dialog to mute audio. Shown when volume is currently audible. -->
    <string name="player_mute">Mute</string>
    <!-- Translators: Formatted percentage display in the volume dialog. The double percent (%%) is an Android XML escape for a literal %. -->
    <string name="player_percent"><xliff:g id="value">%1$d</xliff:g>%%</string>
    <!-- Translators: Duration display in the player top bar metadata chips for VOD content. "minutes" is the total duration in minutes. -->
    <string name="player_duration_minutes"><xliff:g id="minutes">%1$d</xliff:g> min</string>
    <!-- Translators: Channel number display on the channel OSD card after a direct tune. "number" is the channel number string. The hash (#) is a conventional channel prefix. -->
    <string name="player_channel_number">#<xliff:g id="number">%1$s</xliff:g></string>
    <!-- Translators: Live badge shown in the player top bar, on the live timeline tooltip, and in the audio now-playing bar. All caps is intentional for this badge. This is a state indicator, not a command. -->
    <string name="player_live">LIVE</string>
    <!-- Translators: One-time hint over the live player when a channel keeps dropping frames. State the fact plainly; there is no other engine to switch to. -->
    <string name="player_smoothness_hint">This channel is dropping frames — the picture may stutter.</string>
    <string name="player_error_stream_link">Could not get a stream link from the portal. Check the connection and try again.</string>
    <!-- Translators: Error when the video file is not properly configured for streaming (missing fast-start). -->
    <string name="player_error_not_streaming">This video isn\'t formatted for streaming. Ask the provider to re-encode with fast-start, or download it first.</string>
    <!-- Translators: Error when the connection to a live channel is lost. -->
    <string name="player_error_lost_connection">Lost connection to this channel.</string>
    <!-- Translators: Generic error when a channel fails to play. -->
    <string name="player_error_channel">Couldn\'t play this channel.</string>
    <!-- Translators: Error when ExoPlayer cannot decode the video format. "error" is the engine error code/message. "ExoPlayer" is a brand name. -->
    <string name="player_error_exo_decode">ExoPlayer can\'t decode this video\'s format on this device (<xliff:g id="error">%1$s</xliff:g>).</string>
    <!-- Translators: Error when ExoPlayer fails to play the stream. "error" is the engine error code/message. -->
    <string name="player_error_exo_play">ExoPlayer couldn\'t play this stream (<xliff:g id="error">%1$s</xliff:g>).</string>
    <!-- Translators: Toast when an external player cannot open the stream URL. -->
    <string name="player_external_could_not_open">Could not open this stream.</string>
    <!-- Translators: Toast when no external player app is installed. "VLC" and "MX Player" are brand names. -->
    <string name="player_external_not_found">No external player found \u2014 install VLC or MX Player.</string>
    <!-- Translators: Error when audio plays but video cannot be rendered on this device. -->
    <string name="player_error_audio_no_video">Audio is playing, but video could not be rendered on this device.</string>
    <!-- Translators: Error when the TV\'s hardware video decoder is busy. -->
    <string name="player_error_decoder_busy">This TV\'s video decoder is busy. Try again in a moment.</string>
    <!-- Translators: Error when there is no internet connection. -->
    <string name="player_error_no_internet">No internet connection. Check your network and try again.</string>
    <!-- Translators: Error title when the provider refuses playback because the same account is already streaming elsewhere (HTTP 458). "Retry" is the button below it. -->
    <string name="player_error_account_in_use">This account is already playing on another device or app. Stop it there, then press Retry.</string>
    <!-- Translators: Player error for a channel or film the playlist marks as protected with Apple's FairPlay DRM. No Android device can decrypt FairPlay, so this is a limit of the device, not of the app or the provider. Keep "Apple FairPlay", "Android" and "Apple" as they are. -->
    <string name="player_error_fairplay">This stream is protected by Apple FairPlay, which Android devices can\'t play. The playlist is made for Apple devices.</string>
    <!-- Translators: Notification when the audio output cannot do surround and falls back to stereo. -->
    <string name="player_error_surround">This audio output can\'t do surround \u2014 switched to stereo.</string>
    <!-- Translators: Error when hardware decoding fails and software decoding cannot handle the resolution. "resolution" is a string such as "4K" or "3840x2160". This is a technical diagnostic, not actionable advice for most users. -->
    <string name="player_error_hardware_fallback">This stream\'s format couldn\'t be hardware-decoded on this TV, so it fell back to software decoding \u2014 which can\'t sustain <xliff:g id="resolution">%1$s</xliff:g> without overloading the TV. The TV may still play other 4K content fine; this particular stream\'s format is the issue.</string>
    <!-- Translators: Error when hardware decoding is disabled in settings and the resolution is too high for software decoding. "resolution" is a string such as "4K". Directs the user to Settings. -->
    <string name="player_error_hardware_disabled">Hardware decoding is turned off \u2014 software decoding can\'t handle <xliff:g id="resolution">%1$s</xliff:g> video. Enable it in Settings \u2192 Video Player.</string>
    <!-- Translators: Technical failure reason shown in the player error overlay detail section. "HEVC 10-bit" is a video codec example. -->
    <string name="player_reason_decoder_busy">Hardware video decoder is busy or can\'t handle this stream</string>
    <!-- Translators: Technical failure reason in the player error overlay. -->
    <string name="player_reason_decoder_transient">Hardware video decoder error \u2014 transient, try again</string>
    <!-- Translators: Technical failure reason. "HEVC 10-bit" is an example format/profile. -->
    <string name="player_reason_unsupported_video">This device\'s decoder doesn\'t support this video format/profile (e.g. HEVC 10-bit)</string>
    <!-- Translators: Technical failure reason. Suggests closing other apps to free memory. -->
    <string name="player_reason_decoder_memory">Device ran out of memory for the decoder \u2014 try closing other apps</string>
    <!-- Translators: Technical failure reason. "DRM" means Digital Rights Management. -->
    <string name="player_reason_drm">DRM / secure-decoder error</string>
    <!-- Translators: Technical failure reason. "HTTP 509" is the HTTP status code. "too many streams at once" is the provider-side cause. -->
    <string name="player_reason_http_509">Provider blocked the connection \u2014 too many streams at once (HTTP 509)</string>
    <!-- Translators: Technical failure reason. "HTTP 403" is the status code. Lists possible causes: credentials, subscription, or IP block. -->
    <string name="player_reason_http_403">Provider denied access (HTTP 403) \u2014 credentials, subscription, or IP block</string>
    <!-- Translators: Technical failure reason. "HTTP 401" is the status code. -->
    <string name="player_reason_http_401">Provider rejected your login (HTTP 401)</string>
    <!-- Translators: Technical failure reason. "HTTP 404" is the status code. -->
    <string name="player_reason_http_404">Stream not found on the provider (HTTP 404)</string>
    <!-- Translators: Technical failure reason. "HTTP 400" is the status code. "bad or expired link" is the cause. -->
    <string name="player_reason_http_400">Provider rejected the request (HTTP 400) \u2014 bad or expired link</string>
    <!-- Translators: Technical failure reason about an invalid or expired SSL certificate from the provider. -->
    <string name="player_reason_ssl">Provider\'s SSL certificate is invalid or expired</string>
    <!-- Translators: Technical failure reason when the stream format is unrecognized. -->
    <string name="player_reason_format">Stream format not recognized (bad or partial stream)</string>
    <!-- Translators: Technical failure reason for network reachability issues. -->
    <string name="player_reason_network">Network problem reaching the provider</string>
    <!-- Translators: Technical failure reason when the audio format is unsupported. -->
    <string name="player_reason_audio">Audio output error \u2014 the device couldn\'t play this audio format</string>
    <!-- Translators: Fallback label for an audio track when it has no name or language. "number" is the track index. -->
    <string name="player_audio_track_number">Audio <xliff:g id="number">%1$d</xliff:g></string>
    <!-- Translators: Fallback label for a subtitle track when it has no name or language. "number" is the track index. -->
    <string name="player_subtitle_track_number">Subtitle <xliff:g id="number">%1$d</xliff:g></string>
    <!-- Translators: Visible middle-dot separator between inline metadata segments in the player HUD, stream info overlay, launcher metadata, and subtitle track labels. -->
    <string name="player_metadata_separator">" · "</string>
    <!-- Translators: Title of the technical stream info overlay shown in the player. -->
    <string name="player_stream_info">Stream info</string>
    <!-- Translators: Row label in the stream info overlay for the playback engine. -->
    <string name="player_stream_engine">Engine</string>
    <!-- Translators: Row label in the stream info overlay for the stream container/transport format. -->
    <string name="player_stream_format">Format</string>
    <!-- Translators: Row label in the stream info overlay for the content source. -->
    <string name="player_stream_source">Source</string>
    <!-- Translators: Row label in the stream info overlay for video codec information. -->
    <string name="player_stream_video">Video</string>
    <!-- Translators: Row label in the stream info overlay for the HDR/SDR mode. -->
    <string name="player_stream_hdr">HDR</string>
    <!-- Translators: HDR mode value in the stream info overlay. "HDR10 (PQ)" is a technical video standard name. -->
    <string name="player_stream_hdr10_pq">HDR10 (PQ)</string>
    <!-- Translators: HDR mode value in the stream info overlay. "HLG" stands for Hybrid Log-Gamma, a technical video standard. -->
    <string name="player_stream_hlg">HLG</string>
    <!-- Translators: HDR mode value in the stream info overlay. "SDR" stands for Standard Dynamic Range. -->
    <string name="player_stream_sdr">SDR</string>
    <!-- Translators: Row label in the stream info overlay for the video bitrate. -->
    <string name="player_stream_bitrate">Bitrate</string>
    <!-- Translators: Row label in the stream info overlay for the video decoder type. -->
    <string name="player_stream_decoder">Decoder</string>
    <!-- Translators: Row label in the stream info overlay for audio codec information. -->
    <string name="player_stream_audio">Audio</string>
    <!-- Translators: Row label in the stream info overlay for the buffer status. -->
    <string name="player_stream_buffer">Buffer</string>
    <!-- Translators: Frame rate display in the stream info overlay. "fps" means frames per second. -->
    <string name="player_stream_fps"><xliff:g id="fps">%1$.2f</xliff:g> fps</string>
    <!-- Translators: Bit depth display in the stream info overlay. "bits" is the bit depth integer (e.g. 8, 10). -->
    <string name="player_stream_bit_depth"><xliff:g id="bits">%1$d</xliff:g>-bit</string>
    <!-- Translators: Bitrate display in the stream info overlay. "value" is a number. "Mbps" means megabits per second. -->
    <string name="player_stream_mbps"><xliff:g id="value">%1$s</xliff:g> Mbps</string>
    <!-- Translators: Audio sample rate display in the stream info overlay. "value" is a number. "kHz" means kilohertz. -->
    <string name="player_stream_khz"><xliff:g id="value">%1$s</xliff:g> kHz</string>
    <!-- Translators: Audio bitrate display in the stream info overlay. "value" is a number. "kbps" means kilobits per second. -->
    <string name="player_stream_kbps"><xliff:g id="value">%1$s</xliff:g> kbps</string>
    <!-- Translators: Buffer duration display in the stream info overlay. "value" is a number. "s" means seconds. -->
    <string name="player_stream_seconds"><xliff:g id="value">%1$s</xliff:g> s buffered</string>
    <!-- Translators: Heading of the plate shown over the black video area when the item being played has no video track at all (a radio channel, a music-only file). This is NOT an error - playback is working. -->
    <string name="player_audio_only_title">Audio only</string>
    <!-- Translators: Body of the "Audio only" plate. Reassures the user that nothing is broken: the item simply contains no picture. -->
    <string name="player_audio_only_body">This one has sound but no picture. Nothing is wrong — it\'s playing normally.</string>
    <!-- Translators: Audio channel label for mono audio in the stream info overlay. Lowercase is intentional for this technical label. -->
    <string name="player_audio_mono">mono</string>
    <!-- Translators: Audio channel label for stereo audio in the stream info overlay. -->
    <string name="player_audio_stereo">stereo</string>
    <!-- Translators: Plural audio channel count display in the stream info overlay. "count" is the number of audio channels. -->
    <plurals name="player_audio_channels">
        <item quantity="one"><xliff:g id="count">%1$d</xliff:g> channel</item>
        <item quantity="other"><xliff:g id="count">%1$d</xliff:g> channels</item>
    </plurals>
    <!-- Translators: Plural dropped-frame count in the stream info overlay. "count" is the number of dropped frames. -->
    <plurals name="player_stream_dropped_frames">
        <item quantity="one"><xliff:g id="count">%1$d</xliff:g> frame dropped</item>
        <item quantity="other"><xliff:g id="count">%1$d</xliff:g> frames dropped</item>
    </plurals>
    <!-- Translators: Decoder type label in the stream info overlay and media spec display. Lowercase is intentional. -->
    <string name="player_decoder_hardware">hardware decoder</string>
    <!-- Translators: Decoder type label. Lowercase is intentional. -->
    <string name="player_decoder_software">software decoder</string>
    <!-- Translators: Decoder qualifier appended when the decoder operates in direct mode. Lowercase is intentional. -->
    <string name="player_decoder_direct">direct</string>
    <!-- Translators: Decoder qualifier appended when the decoder uses GPU acceleration. Uppercase is intentional for this abbreviation. -->
    <string name="player_decoder_gpu">GPU</string>


    <!-- Translators: Playback-log event headline after surround output fails. -->
    <string name="player_reason_stereo_fallback">Switched to stereo audio</string>
    <!-- Translators: Playback-log event headline when a provider permits only one active connection. -->
    <string name="player_reason_one_session_provider">Provider allows one session at a time</string>
    <!-- Translators: Playback-log event headline when Live TV switches to another playback fallback. -->
    <string name="player_reason_live_fallback">Live playback switched to a fallback</string>
    <!-- Translators: Playback-log event headline when Live TV has exhausted every playback fallback. -->
    <string name="player_reason_live_no_fallback">Live playback failed — no fallback remains</string>
    <!-- Translators: Playback-log headline for a diagnostic report explicitly saved by the user. -->
    <string name="player_reason_stream_report">Stream report</string>
    <!-- Translators: Row label describing what the audio engine sends to the TV or receiver. -->
    <string name="player_stream_audio_output">Audio out</string>
    <!-- Translators: Row label for the resolved live pre-buffer and readahead settings. -->
    <string name="player_stream_live_buffer">Live buffer</string>
    <!-- Translators: The TV or receiver decodes the compressed audio stream. -->
    <string name="player_stream_audio_passthrough">passthrough (TV/receiver decodes)</string>
    <!-- Translators: МОЁ ТВ decodes audio before sending it to the output device. -->
    <string name="player_stream_audio_decoded_in_app">decoded in app</string>
    <!-- Translators: PCM audio-output description. "channels" is a localized channel layout such as stereo or 5.1. -->
    <string name="player_stream_audio_pcm"><xliff:g id="channels">%1$s</xliff:g> PCM</string>
    <string name="player_stream_multichannel_allowed">multichannel allowed</string>
    <!-- Translators: Diagnostic suffix followed by a raw technical reason. -->
    <string name="player_stream_fell_back">fell back: <xliff:g id="reason">%1$s</xliff:g></string>
    <!-- Translators: Live diagnostic value. "seconds" is how many seconds of video are collected before play begins. -->
    <string name="player_stream_preroll_video">pre-buffer <xliff:g id="seconds">%1$s</xliff:g>s of video</string>
    <string name="player_stream_preroll_off">pre-buffer off</string>
    <!-- Translators: Live diagnostic value for buffer depth. -->
    <string name="player_stream_depth">depth <xliff:g id="seconds">%1$s</xliff:g>s</string>
    <!-- Translators: Live diagnostic value for the player's readahead (how far ahead of the playhead the buffer reaches). -->
    <string name="player_stream_readahead">readahead <xliff:g id="seconds">%1$s</xliff:g>s</string>
    <string name="player_stream_playlist_override">playlist override</string>
    <!-- Translators: Playback error when a device cannot decode a particular resolution and codec. -->
    <string name="player_error_hardware_format">This TV\'s video hardware can\'t decode <xliff:g id="resolution">%1$s</xliff:g> <xliff:g id="codec">%2$s</xliff:g>. The file is fine, but the TV can\'t play this format at this resolution.</string>
    <!-- Translators: Brief confirmation after the user saves a stream report from the player. -->
    <string name="player_report_saved">Stream report saved to the playback log</string>
    <string name="player_frame_rate_prompt_title">This channel may judder</string>
    <string name="player_frame_rate_prompt_description">It plays at <xliff:g id="fps">%1$d</xliff:g> fps while your TV is running at <xliff:g id="current_hz">%2$d</xliff:g> Hz, which can’t show those frames evenly — motion looks slightly jerky.\n\nAuto frame rate switches the TV to <xliff:g id="target_hz">%3$d</xliff:g> Hz while you watch and puts it back afterwards. Some TVs blank for a moment when the rate changes; you can turn it off again in Settings → Picture → Frame rate.</string>
    <string name="player_frame_rate_turn_on">Turn on</string>
    <!-- Translators: Button on the sound-only player screen. Stops playback after a chosen time so the user can fall asleep to it. -->
    <string name="player_sleep_timer">Sleep timer</string>
    <!-- Translators: Sleep-timer option. Stop when the programme currently on air ends. -->
    <string name="player_sleep_timer_end_of_programme">End of programme</string>
    <!-- Translators: Sleep-timer status. The placeholder is an already-formatted duration, for example 30 min. -->
    <string name="player_sleep_timer_remaining">Stops in <xliff:g id="time">%1$s</xliff:g></string>
    <!-- Translators: Tick row in the sleep-timer picker. When the timer ends, the screen is switched off too, not only the video stopped. -->
    <string name="player_sleep_timer_screen_off">Also turn off the screen</string>
    <!-- Translators: Shown by the system when the user allows the app to switch the screen off. Says what the permission is used for. -->
    <string name="player_sleep_timer_screen_off_explanation">Used only to turn the screen off when the sleep timer ends, never at any other time.</string>
    <!-- Translators: Short message when the device has no way to give the app that permission (some TVs). -->
    <string name="player_sleep_timer_screen_off_unavailable">This device does not let apps turn the screen off.</string>
    <!-- Translators: Player error shown when a Chromecast-style receiver refuses the stream. The receiver decodes the stream itself, so a format it does not support cannot be cast at all. -->
    <string name="player_error_cast_unsupported">The device you\'re casting to can\'t play this stream. Many live channels use a format it doesn\'t support \u2014 play it on your phone instead.</string>
    <!-- Translators: Player button that turns the fullscreen channel into a Multiview grid. -->
    <string name="multiview_button">Multiview</string>
    <!-- Translators: Placeholder on an empty Multiview tile. -->
    <string name="multiview_add_channel">Add channel</string>
    <!-- Translators: Shown on a tile the provider has no connection left for. -->
    <string name="multiview_refused_single">Your provider allows one stream at a time.</string>
    <!-- Translators: Shown on a tile when every connection is in use. "count" is 2 or more. -->
    <plurals name="multiview_refused_all_in_use">
        <item quantity="one">Your provider allows <xliff:g id="count">%1$d</xliff:g> stream at a time, and it is in use.</item>
        <item quantity="other">Your provider allows <xliff:g id="count">%1$d</xliff:g> streams at a time, and they are all in use.</item>
    </plurals>
    <!-- Translators: Shown when a recording is refused because the last connection is kept for watching. -->
    <string name="multiview_refused_reserved">One connection is kept free so you can keep watching. Change that in Settings to record on every connection.</string>
    <!-- Translators: Shown on a tile the device has no video decoder left for. -->
    <string name="multiview_decoder_exhausted">This TV can\'t decode another channel at the same time.</string>
    <!-- Translators: Tile menu: pick a different channel for this tile. -->
    <string name="multiview_tile_change_channel">Change channel</string>
    <!-- Translators: Tile menu: make this tile the only thing on screen. -->
    <string name="multiview_tile_fullscreen">Make fullscreen</string>
    <!-- Translators: Tile menu: empty this tile. -->
    <string name="multiview_tile_remove">Remove tile</string>
    <!-- Translators: Description of the badge on the tile whose sound is playing. -->
    <string name="multiview_audio_tile">Sound is on this tile</string>
    <!-- Translators: Channel menu entry: keep this channel for the Multiview grid. -->
    <string name="multiview_add_to">Add to Multiview</string>
    <!-- Translators: Confirmation after adding. "count" is how many are kept, "total" the grid size. -->
    <string name="multiview_added">Kept for Multiview · <xliff:g id="count">%1$d</xliff:g> of <xliff:g id="total">%2$d</xliff:g>. Play a channel to open the grid.</string>
    <!-- Translators: Tile menu: play this tile without a picture, for its sound only. -->
    <string name="multiview_tile_sound_only">Sound only</string>
    <!-- Translators: Tile menu: give a sound-only tile its picture back. The opposite of "Sound only". -->
    <string name="multiview_tile_show_picture">Show the picture</string>
    <!-- Translators: Shown on a sound-only tile. It still uses one provider connection. -->
    <string name="multiview_sound_only_note">Sound only — still one of your provider\'s streams</string>
