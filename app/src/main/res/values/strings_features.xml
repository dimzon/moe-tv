<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- Profiles -->
    <!-- Translators: Label for the PIN input in the profile editor. -->
    <string name="profiles_pin">PIN</string>
    <!-- Translators: Placeholder dots shown in the PIN input field. -->
    <string name="profiles_pin_placeholder">\u00b7\u00b7\u00b7\u00b7</string>

    <!-- Search -->
    <!-- Translators: Screen title for the global search screen. -->
    <string name="search_title">Search</string>
    <!-- Translators: Section header in search results for continue-watching items. -->
    <string name="search_continue">Continue watching</string>
    <!-- Translators: Section header in search results for recent searches. -->
    <string name="search_recent">Recent searches</string>
    <!-- Translators: Empty-state message when a list category has no items. "list" is the list name. -->
    <string name="search_nothing_in_list">Nothing in <xliff:g id="list">%1$s</xliff:g> yet.</string>
    <!-- Translators: Search-results section heading for jumping to a result in its native screen. -->
    <string name="search_jump_to">Jump to</string>
    <!-- Translators: Content type label in search results. -->
    <string name="search_channels">Channels</string>
    <!-- Translators: Search filter button and results heading for TV guide programmes (on now or later today) whose title matches, with the channel showing them. Not films or series from the catalogue. -->
    <string name="search_on_tv">TV Shows</string>
    <!-- Translators: Key hint on a channel search result: OK takes you to the channel in Live TV (it does not play it). -->
    <string name="search_go_to_channel">Go to channel</string>
    <!-- Translators: Button under the recent searches list that deletes them all. -->
    <string name="search_clear_recent">Clear recent searches</string>
    <!-- Translators: Placeholder in the empty search field. -->
    <string name="search_field_hint">Channels and programmes</string>
    <!-- Translators: Spoken label of the microphone button beside the search field (read by screen readers). -->
    <string name="search_voice">Voice search</string>
    <!-- Translators: Prompt the system speech recogniser shows while it listens for a search. -->
    <string name="search_voice_prompt">Say a channel or programme</string>
    <!-- Translators: Title of the card shown on the empty search page. -->
    <string name="search_card_title">Search your channels</string>
    <!-- Translators: Text of the card shown on the empty search page. -->
    <string name="search_card_body">Pick a result to go straight to it and play or open its options. TV programs on now or later today are found by their title too.</string>
    <!-- Translators: Title when a search finds nothing. "query" is the typed text, in quotes. -->
    <string name="search_nothing_found">Nothing found for “<xliff:g id="query">%1$s</xliff:g>”</string>
    <!-- Translators: Line under "Nothing found" explaining what search looks in. -->
    <string name="search_nothing_found_body">Search looks in channel names and in the titles of programmes in the downloaded guide. Hidden categories are not searched.</string>
    <!-- Translators: The typed search text shown in quotes next to the page title. Use your language's quotation marks. -->
    <string name="search_query_quoted">“<xliff:g id="query">%1$s</xliff:g>”</string>
    <!-- Translators: Number of search results next to the page title. -->
    <plurals name="search_result_count">
        <item quantity="one"><xliff:g id="count">%1$d</xliff:g> result</item>
        <item quantity="other"><xliff:g id="count">%1$d</xliff:g> results</item>
    </plurals>
    <!-- Translators: Row under the first channels in search results; opens the list of all matching channels. -->
    <plurals name="search_all_channels">
        <item quantity="one"><xliff:g id="count">%1$d</xliff:g> channel</item>
        <item quantity="other">All <xliff:g id="count">%1$d</xliff:g> channels</item>
    </plurals>

    <!-- Home -->
    <!-- Translators: Empty-state message on the Home screen when nothing is available to preview. -->
    <string name="home_no_preview">Nothing to preview yet.</string>
    <!-- Translators: Empty-state message when all Home rows are hidden. -->
    <string name="home_no_rows">All Home rows are hidden.</string>
    <!-- Translators: Instructional text when Home rows are hidden. Directs to Settings. -->
    <string name="home_enable_rows">Turn rows back on in Settings \u2192 Home screen.</string>
    <!-- Translators: Empty-state message on the Home screen before any watch history exists. -->
    <string name="home_start_watching">Start watching to see your activity here.</string>
    <!-- Translators: Empty-state message for the continue-watching row when no history exists. -->
    <string name="home_continue_empty">Your continue-watching items will appear here once playback history is available.</string>
    <!-- Translators: Timestamp text for very recent activity (within the last minute). -->
    <string name="home_last_watched_now">Last watched just now</string>
    <!-- Translators: Plural "last watched" timestamp for minutes. "count" is the number of minutes. -->
    <plurals name="home_last_watched_minutes">
        <item quantity="one">Last watched <xliff:g id="count">%1$d</xliff:g> minute ago</item>
        <item quantity="other">Last watched <xliff:g id="count">%1$d</xliff:g> minutes ago</item>
    </plurals>
    <!-- Translators: Plural "last watched" timestamp for hours. "count" is the number of hours. -->
    <plurals name="home_last_watched_hours">
        <item quantity="one">Last watched <xliff:g id="count">%1$d</xliff:g> hour ago</item>
        <item quantity="other">Last watched <xliff:g id="count">%1$d</xliff:g> hours ago</item>
    </plurals>
    <!-- Translators: Plural "last watched" timestamp for days. "count" is the number of days. -->
    <plurals name="home_last_watched_days">
        <item quantity="one">Last watched <xliff:g id="count">%1$d</xliff:g> day ago</item>
        <item quantity="other">Last watched <xliff:g id="count">%1$d</xliff:g> days ago</item>
    </plurals>
    <!-- Translators: Home row type label for the card-style row. -->
    <string name="home_row_cards">Cards</string>
    <!-- Translators: Home row name in Settings for the "Keep Watching" row. -->
    <string name="home_row_keep_watching">Keep watching</string>
    <!-- Translators: Home row name in Settings for the "Recent Channels" row. -->
    <string name="home_row_recent_channels">Recent channels</string>
    <!-- Translators: Home row name in Settings for the "Favorite Channels" row. -->
    <string name="home_row_favorite_channels">Favorite channels</string>
    <!-- Translators: Home row name in Settings for the "On Now" row. -->
    <string name="home_row_on_now">On now</string>
    <!-- Translators: Home row description in Settings for the hero row. -->
    <string name="home_row_hero_description">The large preview row at the top</string>
    <!-- Translators: A running time or time left in hours and minutes, abbreviated, e.g. "1 h 05 min". -->
    <string name="home_duration_hours_minutes"><xliff:g id="hours">%1$d</xliff:g> h <xliff:g id="minutes">%2$02d</xliff:g> min</string>
    <!-- Translators: Time remaining, e.g. "31 min left". "duration" is a formatted duration. -->
    <string name="home_time_left"><xliff:g id="duration">%1$s</xliff:g> left</string>
    <!-- Translators: Home row description in Settings for "Recent Channels". -->
    <string name="home_row_recent_description">Live channels you tuned recently</string>
    <!-- Translators: Home row description in Settings for "Favorite Channels". -->
    <string name="home_row_favorite_description">Your favorited live channels</string>


    <!-- Translators: Screen title for the app update dialog. -->
    <string name="update_title">App update</string>
    <!-- Translators: Loading status shown while checking for updates. -->
    <string name="update_checking">Checking for updates\u2026</string>
    <!-- Translators: Update-dialog changelog heading and button label. -->
    <string name="update_whats_new">What\'s new</string>
    <!-- Translators: Progress status shown while downloading an update. "percent" is the download percentage. The double percent (%%) is an XML escape. -->
    <string name="update_downloading">Downloading update\u2026 <xliff:g id="percent">%1$d</xliff:g>%%</string>
    <!-- Translators: Status text indicating an update is available. -->
    <string name="update_available">Update available</string>
    <!-- Translators: Status text when the app is already on the latest version. "version" is the current version string. -->
    <string name="update_latest">You\'re on the latest version (v<xliff:g id="version">%1$s</xliff:g>).</string>
    <!-- Translators: Version comparison display. "available" is the new version, "current" is the installed version. -->
    <string name="update_available_version">Version <xliff:g id="available">%1$s</xliff:g> is available (you have v<xliff:g id="current">%2$s</xliff:g>).</string>
    <!-- Translators: Informational text in the update dialog after download completes. -->
    <string name="update_installer">The system installer opens when the download finishes.</string>
    <!-- Translators: Button in the update dialog to postpone the update. -->
    <string name="update_later">Later</string>
    <!-- Translators: Primary button in the update dialog to start the update immediately. -->
    <string name="update_now">Update now</string>
    <!-- Translators: Button to retry checking for updates. -->
    <string name="update_try_again">Try again</string>
    <!-- Translators: Error when the update check fails due to a network issue. -->
    <string name="update_failed_check">Couldn\'t check for updates.</string>
    <!-- Translators: Error when the update server returns an HTTP error. "code" is the HTTP status code such as 404. Keep this as a full sentence. -->
    <string name="update_failed_check_http">The update server returned HTTP <xliff:g id="code">%1$s</xliff:g> while checking.</string>
    <!-- Translators: Error when no compatible APK is found in the release for this device. -->
    <string name="update_no_compatible_apk">No update package for this device was found in the release.</string>
    <!-- Translators: Error when the update server returns an invalid release description. -->
    <string name="update_invalid_release_response">The update server returned an invalid release description.</string>
    <!-- Translators: Error when the update download fails due to a network error. -->
    <string name="update_failed_download">Couldn\'t download the update because the network request failed.</string>
    <!-- Translators: Error when the update download returns an HTTP error. "code" is the HTTP status code such as 503. Keep the punctuation. -->
    <string name="update_failed_download_http">The update download returned HTTP <xliff:g id="code">%1$s</xliff:g>.</string>
    <!-- Translators: Error when the update server returns an empty APK file. -->
    <string name="update_empty_download">The update server returned an empty APK.</string>
    <!-- Translators: Error when the system installer cannot open the downloaded update. -->
    <string name="update_install_failed">The downloaded update could not be opened by the system installer.</string>
    <!-- Translators: Android refused to start the installer until "install unknown apps" is allowed for this app. -->
    <string name="update_install_permission">Android would not start the installer. Allow installing unknown apps for МОЁ ТВ in Settings › Apps, then try again.</string>
    <!-- Translators: Error when there is not enough free storage to download the update. "size" is a formatted size such as "114 MB". -->
    <string name="update_not_enough_space">Not enough free storage for the update. Free up about <xliff:g id="size">%1$s</xliff:g> and try again.</string>
    <!-- Translators: Error when the downloaded update file is incomplete or corrupted. -->
    <string name="update_damaged_download">The update didn\'t download completely. Check your connection and try again.</string>
    <!-- Translators: Error when the system installer refuses the update. "reason" is the installer's own message, which is usually in English. -->
    <string name="update_install_rejected">The system installer refused the update: <xliff:g id="reason">%1$s</xliff:g></string>
    <!-- Translators: Status text when an update has been downloaded and is ready to install. "available" is the new version, "current" is the installed version. -->
    <string name="update_ready">МОЁ ТВ v<xliff:g id="available">%1$s</xliff:g> is ready (you have v<xliff:g id="current">%2$s</xliff:g>).</string>

    <!-- Translators: Dialog title for the database recovery screen. "МОЁ ТВ" is a brand name. -->
    <string name="recovery_title">МОЁ ТВ could not open its database</string>
    <!-- Translators: Body text on the recovery screen explaining that data is safe and requesting a bug report. -->
    <string name="recovery_data_safe_full">This is a database upgrade failure. Channels will be downloaded from the server again.\n\nPlease report this so it can be fixed, and include the message below.</string>
    <!-- Translators: Button on the recovery screen to retry opening the database. -->
    <string name="recovery_retry">Try again</string>
    <!-- Translators: Hint text on the recovery screen suggesting the user restore from a backup. -->
    <string name="recovery_backup_hint">If you have a backup file you can reset the app and restore it afterwards. Resetting deletes everything stored on this device.</string>
    <!-- Translators: Dialog title for the reset-confirmation dialog on the recovery screen. -->
    <string name="recovery_confirm_reset">Confirm: erase all app data</string>
    <!-- Translators: Button on the recovery screen to reset all app data as a last resort. -->
    <string name="recovery_reset">Reset app data (last resort)</string>

    <!-- Translators: Name of the notification channel for the silent notification kept while the app waits for the TV to wake up (Settings: Auto start on wake-up). -->
    <string name="auto_start_notification_channel">Auto start on wake-up</string>
    <!-- Translators: Text of the silent ongoing notification kept while the app waits for the TV to wake up. МОЁ ТВ is a brand name. -->
    <string name="auto_start_notification_text">МОЁ ТВ opens when the TV wakes up</string>

    <!-- Sports Hub: notifications (phone) -->

    <!-- Sports Hub: screens -->

    <!-- Sports Hub: hub states and settings -->
    <!-- Translators: Move window (Sports settings, and moving categories, channels, films, series and favourites on TV): the arrows choose a row, OK picks it up or puts it down, and only Save or Cancel closes the window. -->
    <string name="sports_move_instructions">▲/▼ to choose · OK to pick up or put down · Save when done</string>
</resources>
