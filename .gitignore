*.iml
.gradle/
.gradle-cache/
.idea/
.kotlin/
local.properties
.DS_Store
**/build/
/captures
.externalNativeBuild
.cxx

# Local tooling / agent state
/.tmp-*/
.codex-*
.claude/
.planning/
.serena/
.codegraph/
.zcode/
.workbuddy-ai/
CLAUDE.md
AGENT_HANDOVER.md

# Python bytecode generated by the branding scripts in extras/branding/
__pycache__/
*.pyc

# Signing keys & secrets — NEVER commit these
*.keystore
*.jks
keystore.properties
signing.properties
/keystore/

# Local-only agent instructions and device/stand inventory. These files contain internal host
# addresses, SSH key paths and VM/container procedures: keep them on disk for development, but never
# commit them (especially once the repository is public).
/AGENTS.md
/DEVICES.md

# Internal planning documents — kept local, never committed. `future_work/` is the core repo's name
# for the same thing; it is listed here too so the same folder name is safe to use anywhere in the
# suite and can never become a committed leak.
future-plan/
audit/
future_work/

# Phase-contract working state (scratch data for the phased redesign), local only
.p1contract/
.p2contract/
PHASE*_CONTRACT.md

# Local production Worker deployments — kept local, never committed. Root-scoped on purpose so it
# cannot swallow source directories that happen to be named `worker/`.
# The upstream self-host examples in `extras/worker/` were removed in cf8b0b5 together with the
# TMDB/OpenSubtitles integrations; no such directory exists in this fork any more.
/worker/

# i18n seed tool run state (batch inputs, IDs, raw results) — never committed
/runs/

# Logcat captures and diagnostic dumps written into the repo root while debugging
# (`adb logcat … | Tee-Object -FilePath .\something.txt`). These routinely contain portal URLs,
# MAC addresses, stream URLs and tokens, so they must never reach a commit. Root-scoped on
# purpose: the baseline profiles under app/src/main/generated/ are .txt and ARE committed.
/*.txt
/*.log

# JVM crash dumps from a Gradle daemon (never worth committing)
hs_err_pid*.log
replay_pid*.log

# Local-only archive (old detailed changelogs etc.), never committed
/archive/

# Auto-incrementing local build counter (see app/build.gradle.kts bumpVersionCode)
versioncode.txt
